# =========================================
# Configuration de l'application
# Copier ce fichier en .env et remplir les vraies valeurs.
# .env ne doit JAMAIS être commité (voir .gitignore).
# =========================================

# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Base de données ---
# Local (Docker) :
DATABASE_URL=postgresql://copilot_user:copilot_pass@localhost:5432/copilot_db
# Plus tard, en remplaçant uniquement cette valeur (Cloud SQL) :
# DATABASE_URL=postgresql://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Vector store (RAG) ---
CHROMA_PERSIST_DIR=./chroma_db

# --- Application ---
# Cloud Run injecte automatiquement PORT — on le lit dynamiquement, jamais en dur.
PORT=8000
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- CORS (à restreindre en production) ---
ALLOWED_ORIGINS=http://localhost:3000
